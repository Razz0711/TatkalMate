# Copy to .env (never commit .env). Only needed for an AUTHORIZED availability provider.
# The adapter refuses irctc.co.in / indianrail.gov.in hosts and plain http.
TATKALMATE_PROVIDER_URL=https://api.your-licensed-provider.example/v1
TATKALMATE_PROVIDER_API_KEY=replace-me
TATKALMATE_PROVIDER_NAME=My licensed provider
# Seconds between requests your provider's terms allow (never below 60).
TATKALMATE_PROVIDER_MIN_INTERVAL=120

# Optional: keep data somewhere other than %LOCALAPPDATA%\TatkalMate
# TATKALMATE_HOME=D:\TatkalMateData
